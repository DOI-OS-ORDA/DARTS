#!/bin/sh

# Usage:
#   bin/doc [input format] [path | bytes] [file path]
#
# Examples:
#   bin/doc pdf path path/to/file.pdf
#   cat path/to/file.docx | bin/doc docx bytes

format=$1
path_or_bytes=$2
filepath=$3

case $format in
  docx)
    case $path_or_bytes in
      path)
        echo "docx path!"
        pandoc -d pandoc.yml -f docx -t markdown "$filepath"
        ;;
      bytes)
        echo "docx bytes!"
        pandoc -d pandoc.yml -f docx -t markdown
        ;;
    esac

    ;;
  pdf)
    case $path_or_bytes in
      path)
        echo "pdf path!"
        pdftotext "$filepath" -
        ;;
      bytes)
        echo "pdf bytes!"
        pdftotext - -
        ;;
    esac
    ;;
  *)
    echo "broken!"
    ;;
esac
